{
  "name": "taf-registry-builder",
  "version": "1.0.0",
  "description": "Automated registry builder for TAF knowledge graph mapping",
  "main": "dist/registry-builder.js",
  "bin": {
    "taf-registry": "./dist/registry-builder.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/registry-builder.js",
    "dev": "ts-node src/page-scanner.ts",
    "registry": "ts-node src/registry-builder.ts",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "analyze": "npm run build && node dist/registry-builder.js",
    "analyze-watch": "chokidar \"**/*.{ts,json,feature}\" -c \"npm run analyze\"",
    "setup": "npm install && npm run build"
  },
  "keywords": [
    "test-automation",
    "knowledge-graph",
    "page-objects",
    "taf",
    "cucumber",
    "gherkin",
    "registry"
  ],
  "author": "Your Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.0",
    "inquirer": "^9.2.0",
    "ora": "^7.0.1",
    "path": "^0.12.7",
    "ts-morph": "^26.0.0",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.54.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.10",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ]
}
